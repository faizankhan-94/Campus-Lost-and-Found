<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAMPUS CONNECT"
            android:textColor="#3157D5"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Welcome, Unitian!🎓"
            android:textColor="#1D2638"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Let's reunite lost items with their owners."
            android:textColor="#6C778B"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="24dp"
            android:background="@android:drawable/edit_text"
            android:hint="Search lost or found items..."
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:padding="12dp"
            android:singleLine="true"
            android:textColor="#1D2638"
            android:textColorHint="#808080"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="What are you looking for?"
            android:textColor="#1D2638"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/reportLostButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#C8553D"
            android:text="Report a Lost Item"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/reportFoundButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#168250"
            android:text="Report a Found Item"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Recent Reports"
            android:textColor="#1D2638"
            android:textSize="21sp"
            android:textStyle="bold" />


        <LinearLayout
            android:id="@+id/reportsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:background="#FFFFFF"
                android:text="Loading reports..."
                android:textColor="#6C778B"
                android:textSize="14sp"
                android:gravity="center" />

        </LinearLayout>


        <Button
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#687386"
            android:text="Logout"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

    </LinearLayout>
    ```

</ScrollView>
