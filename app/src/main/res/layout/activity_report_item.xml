<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAMPUS CONNECT"
            android:textColor="#3157D5"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reportHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Report an Item"
            android:textColor="#1D2638"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Provide accurate details to help reunite the item with its owner."
            android:textColor="#6C778B"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item Name"
            android:textColor="#1D2638"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/itemTitleInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:hint="e.g. Black wallet"
            android:inputType="textCapSentences"
            android:textColor="#212121"
            android:textColorHint="#757575"
            android:padding="12dp"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Description"
            android:textColor="#1D2638"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/itemDescriptionInput"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:gravity="top"
            android:hint="Describe the item and identifying details"
            android:inputType="textCapSentences|textMultiLine"
            android:textColor="#212121"
            android:textColorHint="#757575"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Location"
            android:textColor="#1D2638"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/itemLocationInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:hint="Where was it lost or found?"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:textColor="#212121"
            android:textColorHint="#757575"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Contact Details"
            android:textColor="#1D2638"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/itemContactInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:hint="Email or phone number"
            android:inputType="text"
            android:textColor="#212121"
            android:textColorHint="#757575"
            android:padding="12dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/submitReportButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#3157D5"
            android:text="Submit Report"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>


</ScrollView>
